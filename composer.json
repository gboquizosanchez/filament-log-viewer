{
  "name": "gboquizosanchez/filament-log-viewer",
  "description": "Filament Log Viewer",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "laravel",
    "filament",
    "log-viewer"
  ],
  "homepage": "https://github.com/gboquizosanchez",
  "authors": [
    {
      "name": "Germán Boquizo Sánchez",
      "email": "germanboquizosanchez@gmail.com",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Boquizo\\FilamentLogViewer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Boquizo\\FilamentLogViewer\\Tests\\": "tests/"
    }
  },
  "require": {
    "ext-zip": "*",
    "php": "^8.2|^8.3|^8.4|^8.5",
    "symfony/polyfill-php83": "^1.33"
  },
  "require-dev": {
    "filament/filament": "^4.0|^5.0",
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.29",
    "orchestra/testbench": "^10.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-livewire": "^4.0"
  },
  "scripts": {
    "fix": "./vendor/bin/pint .",
    "static": "./vendor/bin/phpstan analyse",
    "coverage": "XDEBUG_MODE=coverage ./vendor/bin/pest --coverage",
    "all": [
      "@fix",
      "@static"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Boquizo\\FilamentLogViewer\\FilamentLogViewerServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "optimize-autoloader": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
